{
  "name": "FICO Xpress — SustainaFund case study",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python .devcontainer/check_setup.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  },
  "containerEnv": {
    "XPAUTH_PATH": "${containerWorkspaceFolder}/xpauth.xpr"
  },
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Streamlit dashboard", "onAutoForward": "notify" } }
}
